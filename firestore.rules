rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().active == true;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ghsslarnoo@gmail.com' ||
        request.auth.token.email == 'verinag.csc@gmail.com'
      );
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isActiveUser() && getUserData().role == 'admin');
    }

    function isTeacher() {
      return isBootstrappedAdmin() || (isActiveUser() && (getUserData().role == 'teacher' || getUserData().role == 'admin'));
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow list: if true;

      allow create, update: if isValidId(userId) &&
        request.resource.data.keys().hasAll(['uid', 'name', 'email', 'role', 'active']) &&
        request.resource.data.role in ['admin', 'teacher'] &&
        request.resource.data.active is bool;

      allow delete: if isValidId(userId) && (isAdmin() || !isSignedIn() || request.auth.uid != userId);
    }

    // 2. Students collection
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isValidId(studentId) &&
        request.resource.data.keys().hasAll(['studentId', 'name', 'className', 'rollNumber']);
      allow delete: if isValidId(studentId);
    }

    // 3. Assessments collection
    match /assessments/{assessmentId} {
      allow read: if true;
      allow create, update: if isValidId(assessmentId) &&
        request.resource.data.keys().hasAll(['assessmentId', 'name', 'className', 'subject']);
      allow delete: if isValidId(assessmentId);
    }

    // 4. Marks collection
    match /marks/{markEntryId} {
      allow read: if true;
      allow create, update: if isValidId(markEntryId) &&
        request.resource.data.keys().hasAll(['markEntryId', 'assessmentId', 'studentId']);
      allow delete: if isValidId(markEntryId);
    }

    // 5. School Configuration collection
    match /config/{configId} {
      allow read: if true;
      allow write: if isValidId(configId);
    }
  }
}
